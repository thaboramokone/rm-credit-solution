# Copy this file to .env (or set these as environment variables in your
# hosting platform's dashboard) before deploying.

# The port the server listens on. Most hosting platforms set this for you
# automatically — you usually don't need to set it yourself.
PORT=3000

# --- Email (OTP delivery) ---
# Create AdminRM@outlook.com at outlook.com first (any password you choose —
# Microsoft, not this app, is the only place that password is ever entered).
# Until these are set, OTP codes are printed to the server console/logs
# instead of emailed — useful for testing, but you MUST set these before
# real customers use the app, or they'll have no way to receive their code.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=AdminRM@outlook.com
SMTP_PASS=your-outlook-password-here
SMTP_FROM=AdminRM@outlook.com
